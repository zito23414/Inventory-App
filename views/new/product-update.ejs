
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar <%= product.name %> | Inventory</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="header">
    <a href="/" class="store-title">Inventory</a>
    <nav class="categories">
      <a href="/">Todos los productos</a>
    </nav>
  </header>

  <main class="main">
    <section class="page-heading">
      <div>
        <p class="eyebrow">INVENTORY MANAGEMENT</p>
        <h1>Editar producto</h1>
        <p class="edit-subtitle">
          Modificá la información de <strong><%= product.name %></strong>.
        </p>
      </div>

      <a href="/products/<%= product.id %>" class="btn btn-secondary">
        Cancelar
      </a>
    </section>

    <section class="product-form-container edit-form-container">
      <div class="edit-form-header">
        <div>
          <h2>Información del producto</h2>
          <p>Los campos contienen los valores actuales.</p>
        </div>

        <span class="product-id">ID #<%= product.id %></span>
      </div>

      <form
        action="/products/<%= product.id %>/edit"
        method="POST"
        class="product-form"
      >
        <div class="form-group">
          <label for="name">Nombre del producto</label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= product.name %>"
            required
            maxlength="150"
          >
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Precio ($)</label>
            <input
              type="number"
              id="price"
              name="price"
              value="<%= product.price %>"
              min="0"
              step="0.01"
              required
            >
          </div>

          <div class="form-group">
            <label for="stock">Stock</label>
            <input
              type="number"
              id="stock"
              name="stock"
              value="<%= product.stock %>"
              min="0"
              step="1"
              required
            >
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="category_id">Categoría</label>
            <select id="category_id" name="category_id" required>
              <% categories.forEach(category => { %>
                <option
                  value="<%= category.id %>"
                  <%= String(product.category_id) === String(category.id) ? "selected" : "" %>
                >
                  <%= category.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="brand_id">Marca</label>
            <select id="brand_id" name="brand_id" required>
              <% brands.forEach(brand => { %>
                <option
                  value="<%= brand.id %>"
                  <%= String(product.brand_id) === String(brand.id) ? "selected" : "" %>
                >
                  <%= brand.name %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="edit-form-actions">
          <a
            href="/products/<%= product.id %>"
            class="btn btn-secondary"
          >
            Cancelar
          </a>

          <button type="submit" class="btn btn-edit">
            Guardar cambios
          </button>
        </div>
      </form>
    </section>
  </main>

  <footer class="footer">
    Inventory App
  </footer>
</body>
</html>
